# Fake env for the jarx demo home. Every value here is made up.
# jarx reads this instead of the real env when run with --home testdata/demo.
ANTHROPIC_API_KEY=sk-ant-demo-0000-not-a-real-key
GITHUB_TOKEN=demo-not-a-real-token
EDITOR=vim

# Where the demo's agents are installed: the native Claude launcher, then
# the npm prefix's commands (bin on Unix, the prefix itself on Windows).
PATH=~/.local/bin;~/npm/bin;~/npm
NPM_CONFIG_PREFIX=~/npm
