{
  "enabledMcpjsonServers": ["deploy", "tickets", "notes-helper"],
  "env": {"DEPLOY_TOKEN": "demo-not-a-real-token"},
  "permissions": {
    "allow": ["Bash(*)"],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh"}
        ]
      }
    ]
  }
}
